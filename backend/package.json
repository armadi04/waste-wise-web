{
  "name": "nestplate-backend",
  "version": "0.0.1",
  "description": "",
  "author": "AndikaDS <https://github.com/andikadevs>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bun run test:unit",
    "test:unit": "bun --no-env-file test/run-unit.ts test ./test/unit --max-concurrency=1 --timeout=30000",
    "test:watch": "bun --no-env-file test/run-unit.ts test ./test/unit --watch --max-concurrency=1 --timeout=30000",
    "test:cov": "bun --no-env-file test/run-unit.ts test ./test/unit --coverage --max-concurrency=1 --timeout=30000",
    "test:debug": "bun --no-env-file test/run-unit.ts --inspect test ./test/unit --max-concurrency=1 --timeout=30000",
    "test:e2e": "bun test ./test/*.e2e.spec.ts --max-concurrency=1 --timeout=30000",
    "schema:check": "bun run src/scripts/check-schema.ts",
    "seed": "bun run src/scripts/seed.ts",
    "media:bind-storage": "bun run src/scripts/bind-media-storage.ts",
    "migrate:fresh": "bun run src/scripts/reset-db.ts",
    "migrate:fresh:seed": "bun run src/scripts/reset-db.ts --seed",
    "typeorm": "bun run node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "bun run node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "bun run node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:run:prod": "bun run node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "bun run node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "bun run node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "spec:generate": "bun --no-env-file test/run-unit.ts src/scripts/generate-spec.ts",
    "docs:api": "bunx @redocly/cli build-docs swagger.json -o ../docs/index.html --title \"WasteWise API\"",
    "graphql:types": "bun run src/scripts/generate-graphql-types.ts",
    "test:http": "bun --no-env-file test/run-unit.ts test ./test/http --max-concurrency=1 --timeout=30000"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "3.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.10",
    "@keyv/redis": "^5.1.6",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "12.1.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dataloader": "^2.2.3",
    "fastify": "5.12.5",
    "file-type": "^22.3.0",
    "google-auth-library": "^11.3.3",
    "graphql": "^16.15.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-scalars": "^2.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "qs": "6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "12.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "6.14.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-morph": "^28.0.0",
    "tsc-alias": "^1.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
