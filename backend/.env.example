# Copy to .env and replace placeholders. Never commit runtime credentials.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001
APP_NAME=Nestplate
ALLOWED_ORIGINS=http://localhost:3001
APP_DEFAULT_TIME_ZONE=Asia/Jakarta
# Default ignores forwarded headers. Use only the actual reverse proxy IPs/CIDRs.
# TRUST_PROXY=loopback
# Blanket true/hop-count trust is rejected; see docs/OPERATIONS.md.
# LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_me
DB_NAME=nestplate
DB_SYNCHRONIZE=false
DB_SEED=true

JWT_SECRET=replace_with_random_secret_min_32_chars
SESSION_ADMIN_IDLE_MINUTES=120
SESSION_ADMIN_ABSOLUTE_HOURS=8
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
# Optional verified demo user for role-scoped checks.
# DEMO_USER_EMAIL=user@example.com
# DEMO_USER_PASSWORD=replace_with_strong_password

# Default media provider: Depot. Only the selected provider is required at boot.
MEDIA_PROVIDER=depot
MEDIA_MAX_FILE_SIZE=20971520
MEDIA_MAX_CONCURRENT_UPLOADS=4
# MIME is detected from bytes; SVG/HTML/plain text are not allowed by default.
# MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,video/mp4,audio/mpeg,audio/wav,application/zip
DEPOT_BASE_URL=https://depot.example.com
DEPOT_API_KEY=replace_with_depot_write_key

# Named profiles preserve old locations when changing buckets/services.
# Credentials remain runtime secrets. Never change an existing profile's location.
# MEDIA_STORAGE_PROFILE=primary
# MEDIA_STORAGE_PROFILES='{"primary":{"provider":"depot","baseUrl":"https://depot.example.com","apiKey":"replace_me"},"archive":{"provider":"s3","endpoint":"https://s3.example.com","region":"us-east-1","bucket":"archive","accessKeyId":"replace_me","secretAccessKey":"replace_me","forcePathStyle":true}}'

# Direct S3-compatible storage: set MEDIA_PROVIDER=s3 and configure these.
# Keep both providers configured when retaining files uploaded through both.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=nestplate
# S3_ACCESS_KEY_ID=replace_me
# S3_SECRET_ACCESS_KEY=replace_me
# S3_FORCE_PATH_STYLE=true

# Redis is optional; omit REDIS_HOST for in-memory cache.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_TTL=3600
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Optional Google OAuth and CAPTCHA.
# GOOGLE_CLIENT_ID=
# TURNSTILE_ENABLED=true
# TURNSTILE_ALLOWED_HOSTNAMES=localhost,app.example.com
# TURNSTILE_SECRET=
# TURNSTILE_SECRET_KEY=           # legacy alias
# Staging/production require Turnstile unless explicitly disabled.

# OIDC SSO is disabled when SSO_ISSUER is omitted.
# SSO_ISSUER=https://identity.example.com/oidc
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=http://localhost:3001/api/v1/auth/sso/callback
# SSO_POST_LOGOUT_URI=http://localhost:3001
# SSO_SUCCESS_REDIRECT=/
# SSO_DEFAULT_ROLE=user

# SMTP is needed for actual verification, invitation and password-reset delivery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.com
# MAIL_FROM_NAME=Nestplate

# Reports call this internal ML service. Leave unset to save reports without classification.
# ML_SERVICE_URL=http://localhost:8000
# ML_SERVICE_TIMEOUT_MS=15000

# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100

# GraphQL opt-in, served at /graphql.
# GRAPHQL_ENABLED=false
# GRAPHQL_PLAYGROUND=false
# GRAPHQL_MAX_COMPLEXITY=1000
# GRAPHQL_MAX_DEPTH=10
# GRAPHQL_PERSISTED_ONLY=false

# Release notes: configure your fork's GitHub repository.
# GITHUB_REPO=your-org/your-repo
# GITHUB_TOKEN=
