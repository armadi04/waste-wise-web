# Business runtime timezone is fixed to Asia/Jakarta by config/env.ts (timestamps are UTC).
# ─────────────────────────────────────────────────────────────────────────────
# Backend environment — validated by src/config/env.ts (Zod). The app THROWS on
# startup if a required var is missing or invalid. Copy to `.env` and fill in.
# Required vars are uncommented; optional ones are commented with their default.
# ─────────────────────────────────────────────────────────────────────────────

# App / Server
NODE_ENV=development              # development | staging | production | test
# PORT=3000
APP_URL=http://localhost:3000
APP_NAME=KuponMalam            # issuer shown in authenticator apps for 2FA codes
ALLOWED_ORIGINS=http://localhost:3002 # explicit frontend origins for cookie sessions
# TRUST_PROXY=loopback           # trust X-Forwarded-For from these proxies (hop count or addresses/subnets)
# PORTAL_APP_URL=http://localhost:3002 # public portal origin for gift links in API responses/emails
# PORTAL_PAYMENT_WEBHOOK_SECRET= # optional provider callback secret; configure at runtime
# LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal

# Database (PostgreSQL) — all required
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=nest
# DB_SYNCHRONIZE=false            # on: auto-sync schema (dev). off: run migrations on boot (prod). defaults to true off-production
# DB_SEED=true                    # run the seeder on startup

# Portal demo seed (optional; development/staging only)
# PORTAL_SEED_EMAIL=demo@example.com
# PORTAL_SEED_NAME=Portal Demo

# JWT — required, min 16 chars
JWT_SECRET=change_me_min_16_chars
# Session lifetimes: idle = max gap between refreshes, absolute = hard limit since login.
# Admin covers dashboard/SSO/impersonation; portal covers customer OTP/Google logins.
SESSION_ADMIN_IDLE_MINUTES=120
SESSION_ADMIN_ABSOLUTE_HOURS=8
SESSION_PORTAL_IDLE_DAYS=14
SESSION_PORTAL_ABSOLUTE_DAYS=30

# Voucher/ticket QR tokens — optional (derived from JWT_SECRET when unset), min 32 chars
# PASS_QR_SECRET=change_me_pass_qr_secret_min_32_chars
# PASS_QR_TTL_SECONDS=60

# Admin seed account — required (created by the seeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123        # min 8 chars

# Depot media service — all required (storage is delegated to Depot)
DEPOT_BASE_URL=https://media.example.com   # Depot service origin, no /api/v1
DEPOT_API_KEY=mk_your_write_scoped_key      # per-app WRITE-scoped key

# Redis cache (optional — omit REDIS_HOST to use in-memory cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_TTL=3600                  # seconds
# REDIS_USERNAME=                 # Redis ACL user
# REDIS_PASSWORD=                 # Redis requirepass / ACL password

# OAuth / CAPTCHA (optional)
# GOOGLE_CLIENT_ID=               # enables Google login
# Turnstile is required by default in staging/production; locally it activates with a secret.
# TURNSTILE_ENABLED=true          # false is an explicit operational opt-out
# TURNSTILE_ALLOWED_HOSTNAMES=portal.example.com,admin.example.com
# TURNSTILE_SECRET=               # matching secret for both frontends
# TURNSTILE_SECRET_KEY=           # legacy alias; TURNSTILE_SECRET takes precedence

# SSO / OIDC (optional — omit SSO_ISSUER to disable SSO login)
# SSO_ISSUER=https://passport.stekom.ac.id/oidc
# SSO_CLIENT_ID=your_sso_client_id
# SSO_CLIENT_SECRET=your_sso_client_secret
# SSO_REDIRECT_URI=http://localhost:3001/api/auth/sso/callback
# SSO_POST_LOGOUT_URI=http://localhost:3001
# SSO_SUCCESS_REDIRECT=/
# SSO_DEFAULT_ROLE=user

# Mail / SMTP (optional — required for password-reset / verification emails;
# omit SMTP_HOST to leave delivery disabled)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false                  # true for implicit TLS (port 465)
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASS=your_smtp_password       # Mailgun SMTP password, not the API key
# MAIL_FROM=no-reply@yourdomain.com
# MAIL_FROM_NAME=Kupon Malam

# Rate limiting (optional — defaults: 100 req / 60 000 ms per IP)
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100

# GraphQL (optional — opt-in API surface beside REST, mounted at /graphql)
# GRAPHQL_ENABLED=false
# GRAPHQL_PLAYGROUND=false          # serve playground + introspection (forced off in production)
# GRAPHQL_MAX_COMPLEXITY=1000       # reject queries above this complexity score
# GRAPHQL_MAX_DEPTH=10              # reject queries nested deeper than this
# GRAPHQL_PERSISTED_ONLY=false      # in production, only allow persisted (allow-listed) queries

# Changelog — release notes are read from this repo's GitHub Releases.
# Without a token the API is rate-limited by IP; a private repo needs one.
# GITHUB_REPO=univSTEKOM/nestplate
# GITHUB_TOKEN=

# Business fallback; runtime and PostgreSQL sessions use UTC.
APP_DEFAULT_TIME_ZONE=Asia/Jakarta
# Set only after verifying legacy naive timestamps are UTC before migration.
# LEGACY_TIMESTAMP_TIME_ZONE=UTC

# VA sandbox only; disabled in staging/production. No real bank transfer.
PORTAL_PAYMENT_MODE=sandbox
