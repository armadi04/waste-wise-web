{
	http_port 3000
	admin off
}

:3000 {
	root * /srv/dist

	route {
		@backend path /api /api/* /socket.io /socket.io/* /graphql
		handle @backend {
			reverse_proxy {$BACKEND_URL:http://backend:3000}
		}

		@immutable {
			path /assets/*
		}

		handle @immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Handle SPA fallback - No Cache for index.html to ensure updates
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
			encode zstd gzip
		}
	}
}
