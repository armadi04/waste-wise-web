{
	http_port 3000
	admin off
}

:3000 {
	root * /srv/dist

	# TLS is terminated by the platform proxy; these headers apply to every response.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	route {
		@backend path /api /api/* /socket.io /socket.io/* /graphql
		handle @backend {
			reverse_proxy {$BACKEND_URL:http://backend:3000}
		}

		@immutable {
			path /assets/*
		}

		handle @immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Handle SPA fallback - No Cache for index.html to ensure updates
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
			encode zstd gzip
		}
	}
}
